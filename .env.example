# ===== LLM（智谱 GLM，OpenAI 兼容）=====
# 你的智谱 API key（此文件复制为 .env 后填写；.env 已 gitignore，严禁提交）
ZHIPU_API_KEY=sk-xxxxxxxxxxxxxxxx

# OpenAI 兼容接入地址（智谱开放平台，如官方有更新以官方文档为准）
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 文本模型（出题/批改/助手）；具体型号 M0 实测后定，以智谱开放平台当前在售型号为准
LLM_MODEL=glm-4-plus

# 视觉模型（图片 OCR）
LLM_VISION_MODEL=glm-4v-plus

# ===== LangSmith（调用追踪，本地学习/调试用）=====
# 开关：true = 每次调用自动上报 trace 到 LangSmith 云端；false = 完全关闭，不影响功能
LANGSMITH_TRACING=true
# LangSmith 平台申请的 key（https://smith.langchain.com，免费个人版每月 5000 traces）
LANGSMITH_API_KEY=lsv2_pt_xxxxxxxxxxxx
# 项目名（LangSmith 里按项目分组查看 trace）
LANGSMITH_PROJECT=en-learning

# ===== 应用 =====
APP_ENV=dev
DATABASE_URL=sqlite:///./enlearning.db
UPLOAD_DIR=uploads
